@inherits LayoutComponentBase

<div class="min-h-screen flex bg-zinc-950 text-zinc-100">
    <aside class="w-56 shrink-0 border-r border-zinc-800 bg-zinc-900">
        <NavMenu />
    </aside>

    <main class="flex-1 min-w-0">
        <article class="px-8 py-6 max-w-6xl mx-auto">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 inset-x-0 hidden bg-amber-900 text-amber-100 px-4 py-2 text-sm">
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss cursor-pointer">×</span>
</div>
