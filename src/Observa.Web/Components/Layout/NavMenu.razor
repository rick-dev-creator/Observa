@implements IDisposable
@inject NavigationManager Nav

<div class="px-4 py-5 border-b border-zinc-800">
    <a href="" class="text-xl font-semibold tracking-tight text-zinc-100 hover:text-white">Observa</a>
    <p class="text-xs text-zinc-500 mt-1">Financial observability</p>
</div>

<nav class="flex flex-col py-2 text-sm">
    <NavItem Href="" Match="NavLinkMatch.All" Label="Dashboard" />
    <NavItem Href="streams" Label="Streams" />
    <NavItem Href="streams/new" Label="Register stream" />
</nav>

@code {
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
