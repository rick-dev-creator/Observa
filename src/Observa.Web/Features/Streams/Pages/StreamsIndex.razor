@page "/streams"
@rendermode InteractiveServer
@inject StreamQueryService Query

<PageTitle>Streams · Observa</PageTitle>

<header class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Streams</h1>
        <p class="text-sm text-zinc-500">All registered streams and their connector status.</p>
    </div>
    <button type="button" @onclick="@(() => _registerOpen = true)"
            class="self-start sm:self-auto px-4 py-2 bg-zinc-100 text-zinc-900 rounded text-sm font-medium hover:bg-white whitespace-nowrap">
        + Register stream
    </button>
</header>

<Modal IsOpen="_registerOpen"
       Title="Register stream"
       Subtitle="Create an income or outcome stream. Connector binding is optional."
       OnClose="@(() => _registerOpen = false)">
    <RegisterStreamForm OnRegistered="OnRegisteredAsync"
                        OnCancel="@(() => _registerOpen = false)" />
</Modal>

<label class="flex items-center gap-2 text-sm text-zinc-400 mb-4">
    <input type="checkbox" class="h-4 w-4 accent-zinc-100" @bind="_includeTerminal" @bind:after="LoadAsync" />
    Include stopped / deleted
</label>

@if (_rows is null)
{
    <p class="text-zinc-500 text-sm">Loading…</p>
}
else if (_rows.Count == 0)
{
    <p class="text-zinc-500 text-sm">No streams.</p>
}
else
{
    <div class="border border-zinc-800 rounded overflow-hidden">
        <div class="hidden lg:block overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-zinc-900 text-zinc-400 uppercase text-xs tracking-wide">
                    <tr>
                        <th class="text-left px-4 py-2 font-medium">Name</th>
                        <th class="text-left px-4 py-2 font-medium">Direction</th>
                        <th class="text-left px-4 py-2 font-medium">Status</th>
                        <th class="text-left px-4 py-2 font-medium">Connector</th>
                        <th class="text-left px-4 py-2 font-medium">Last poll</th>
                        <th class="text-left px-4 py-2 font-medium">Next poll</th>
                        <th class="text-right px-4 py-2 font-medium">Expected</th>
                        <th class="text-right px-4 py-2 font-medium">Last event</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    @foreach (var row in _rows)
                    {
                        <tr class="hover:bg-zinc-900/50">
                            <td class="px-4 py-2">
                                <a href="streams/@row.Id" class="text-zinc-100 hover:text-white font-medium">@row.Name</a>
                                <div class="text-xs text-zinc-500">@row.Category</div>
                            </td>
                            <td class="px-4 py-2 text-zinc-300">@row.Direction</td>
                            <td class="px-4 py-2"><StatusBadge Status="row.Status" /></td>
                            <td class="px-4 py-2 text-zinc-300">@(row.ConnectorDisplayName ?? "—")</td>
                            <td class="px-4 py-2 @(row.LastPollFailed ? "text-amber-400" : "text-zinc-400")">
                                @FormatRelative(row.LastConnectorPollAt) @(row.LastPollFailed ? "⚠" : "")
                            </td>
                            <td class="px-4 py-2 text-zinc-400">@FormatRelative(row.NextPollEstimate, prefix: "in ")</td>
                            <td class="px-4 py-2 text-right tabular-nums text-zinc-300">
                                @(row.ExpectedAmount is null ? "—" : $"${row.ExpectedAmount:N2}")
                            </td>
                            <td class="px-4 py-2 text-right tabular-nums">
                                @if (row.LastEventAmount is not null)
                                {
                                    <MoneyDisplay Amount="row.LastEventAmount.Value" Direction="row.Direction" />
                                    <div class="text-xs text-zinc-500">@FormatRelative(row.LastEventAt)</div>
                                }
                                else
                                {
                                    <span class="text-zinc-600">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <ul class="lg:hidden divide-y divide-zinc-800">
            @foreach (var row in _rows)
            {
                <li>
                    <a href="streams/@row.Id" class="block px-4 py-3 hover:bg-zinc-900/50">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <div class="min-w-0">
                                <p class="text-zinc-100 font-medium truncate">@row.Name</p>
                                <p class="text-xs text-zinc-500">@row.Direction · @row.Category</p>
                            </div>
                            <StatusBadge Status="row.Status" />
                        </div>
                        <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                            <div>
                                <span class="text-zinc-500">Connector:</span>
                                <span class="text-zinc-300">@(row.ConnectorDisplayName ?? "—")</span>
                            </div>
                            <div>
                                <span class="text-zinc-500">Expected:</span>
                                <span class="text-zinc-300 tabular-nums">@(row.ExpectedAmount is null ? "—" : $"${row.ExpectedAmount:N2}")</span>
                            </div>
                            <div>
                                <span class="text-zinc-500">Last poll:</span>
                                <span class="@(row.LastPollFailed ? "text-amber-400" : "text-zinc-400")">@FormatRelative(row.LastConnectorPollAt)@(row.LastPollFailed ? " ⚠" : "")</span>
                            </div>
                            <div>
                                <span class="text-zinc-500">Next poll:</span>
                                <span class="text-zinc-400">@FormatRelative(row.NextPollEstimate, prefix: "in ")</span>
                            </div>
                            <div class="col-span-2">
                                <span class="text-zinc-500">Last event:</span>
                                @if (row.LastEventAmount is not null)
                                {
                                    <MoneyDisplay Amount="row.LastEventAmount.Value" Direction="row.Direction" />
                                    <span class="text-zinc-500">· @FormatRelative(row.LastEventAt)</span>
                                }
                                else
                                {
                                    <span class="text-zinc-600">—</span>
                                }
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    </div>
}

@code {
    private IReadOnlyList<StreamOperationsView>? _rows;
    private bool _includeTerminal;
    private bool _registerOpen;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _rows = null;
        _rows = await Query.ListOperationsAsync(_includeTerminal, CancellationToken.None);
    }

    private async Task OnRegisteredAsync()
    {
        _registerOpen = false;
        await LoadAsync();
    }

    private static string FormatRelative(DateTimeOffset? when, string prefix = "")
    {
        if (when is null) return "—";
        var delta = when.Value - DateTimeOffset.UtcNow;
        var abs = delta.Duration();
        var unit = abs switch
        {
            { TotalDays: >= 1 } => $"{(int)abs.TotalDays}d",
            { TotalHours: >= 1 } => $"{(int)abs.TotalHours}h",
            { TotalMinutes: >= 1 } => $"{(int)abs.TotalMinutes}m",
            _ => $"{(int)abs.TotalSeconds}s",
        };
        if (string.IsNullOrEmpty(prefix))
            return delta.TotalSeconds < 0 ? $"{unit} ago" : $"in {unit}";
        return $"{prefix}{unit}";
    }
}
