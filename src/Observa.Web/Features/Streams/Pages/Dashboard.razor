@page "/"
@rendermode InteractiveServer
@inject StreamAnalyticsService Analytics
@inject StreamQueryService Query

<PageTitle>Observa</PageTitle>

@if (_loading)
{
    <p class="text-zinc-500 text-sm">Loading…</p>
}
else if (!_hasData)
{
    <div class="border border-dashed border-zinc-700 rounded p-8 sm:p-12 text-center">
        <h1 class="text-2xl font-semibold mb-2">Welcome to Observa</h1>
        <p class="text-zinc-400 mb-6">No streams yet. Register your first income or outcome stream to start.</p>
        <a href="streams" class="inline-block px-4 py-2 bg-zinc-100 text-zinc-900 rounded text-sm font-medium hover:bg-white">
            Register a stream
        </a>
    </div>
}
else
{
    <div class="flex gap-1 mb-6 border-b border-zinc-800" role="tablist">
        <button type="button" role="tab"
                class="@TabClass(0)"
                @onclick="@(() => _activeTab = 0)">
            Overview
        </button>
        <button type="button" role="tab"
                class="@TabClass(1)"
                @onclick="@(() => _activeTab = 1)">
            What if…
        </button>
    </div>

    @if (_activeTab == 1)
    {
        <WhatIfTab Trends="_trends" />
    }
    else
    {
    <StreamFilter Streams="_allStreams" SelectionChanged="OnFilterChangedAsync" />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
        <section class="lg:col-span-2 border border-zinc-800 rounded p-5 sm:p-6">
            <p class="text-xs uppercase tracking-wide text-zinc-500 mb-2">This month so far</p>
            <div class="flex items-baseline gap-3 flex-wrap">
                <AnimatedNumber Target="@_summary!.NetMTD" Signed="true"
                                CssClass="@($"text-3xl sm:text-4xl font-semibold {NetColor(_summary.NetMTD)}")" />
                @if (_summary.Delta is not null && _summary.PreviousMonthSamePoint != 0)
                {
                    <span class="text-sm text-zinc-400">
                        <span class="@DeltaColor(_summary.Delta.Value)">@DeltaArrow(_summary.Delta.Value) @FormatMoney(Math.Abs(_summary.Delta.Value))</span>
                        <span class="text-zinc-600">vs last month</span>
                    </span>
                }
            </div>
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
                <div>
                    <p class="text-xs text-zinc-500">Income</p>
                    <p class="text-emerald-400 tabular-nums">+@FormatMoney(_summary.IncomeMTD)</p>
                </div>
                <div>
                    <p class="text-xs text-zinc-500">Outcome</p>
                    <p class="text-rose-400 tabular-nums">−@FormatMoney(_summary.OutcomeMTD)</p>
                </div>
                <div>
                    <p class="text-xs text-zinc-500">Days remaining</p>
                    <p class="text-zinc-300 tabular-nums">@(_summary.DaysInMonth - _summary.DaysIntoMonth) days</p>
                </div>
            </div>
            @if (_summary.OnTrackEom is not null)
            {
                <p class="mt-4 text-sm text-zinc-400">
                    On track for <span class="text-zinc-200 tabular-nums">~@FormatMoney(_summary.OnTrackEom.Value, signed: true)</span> by month end.
                </p>
            }
        </section>

        <section class="border border-zinc-800 rounded p-5 sm:p-6">
            <p class="text-xs uppercase tracking-wide text-zinc-500 mb-3">Looking ahead</p>
            @if (_projection is not null)
            {
                <div class="space-y-3 text-sm">
                    <div>
                        <p class="text-xs text-zinc-500">End of month</p>
                        <p class="text-lg font-semibold tabular-nums">~@FormatMoney(_projection.EndOfMonth ?? 0m, signed: true)</p>
                    </div>
                    <div>
                        <p class="text-xs text-zinc-500">Next 3 months</p>
                        <p class="tabular-nums">~@FormatMoney(_projection.ThreeMonthsAhead ?? 0m, signed: true)</p>
                    </div>
                    <div>
                        <p class="text-xs text-zinc-500">Year end</p>
                        <p class="tabular-nums">~@FormatMoney(_projection.YearEnd ?? 0m, signed: true)</p>
                    </div>
                    @if (_projection.Uncertainty is { } u and > 0)
                    {
                        <p class="text-xs text-zinc-500 pt-2 border-t border-zinc-800">
                            ±@FormatMoney(u) depending on how variable streams arrive
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(_projection.RunwayMessage))
                    {
                        <p class="text-xs text-zinc-400 pt-1">@_projection.RunwayMessage</p>
                    }
                </div>
            }
        </section>
    </div>

    @if (_retrospective is not null)
    {
        <section class="border border-zinc-800 rounded p-5 sm:p-6 mb-6">
            <p class="text-xs uppercase tracking-wide text-zinc-500 mb-4">Where you've been</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                <div>
                    <p class="text-xs text-zinc-500">Year to date</p>
                    <p class="text-2xl font-semibold tabular-nums @NetColor(_retrospective.YearToDateNet)">
                        @FormatMoney(_retrospective.YearToDateNet, signed: true)
                    </p>
                    <p class="text-xs text-zinc-500 mt-1 tabular-nums">
                        <span class="text-emerald-400">+@FormatMoney(_retrospective.YearToDateIncome)</span>
                        <span class="text-zinc-600">/</span>
                        <span class="text-rose-400">−@FormatMoney(_retrospective.YearToDateOutcome)</span>
                    </p>
                </div>
                @if (_retrospective.YoyDelta is { } yoy && _retrospective.PreviousYearSamePointNet is { } prev)
                {
                    <div>
                        <p class="text-xs text-zinc-500">vs last year</p>
                        <p class="text-2xl font-semibold tabular-nums @DeltaColor(yoy)">
                            @DeltaArrow(yoy) @FormatMoney(Math.Abs(yoy))
                        </p>
                        <p class="text-xs text-zinc-500 mt-1 tabular-nums">
                            prev YTD: @FormatMoney(prev, signed: true)
                        </p>
                    </div>
                }
                @if (_retrospective.BestMonth is { } best)
                {
                    <div>
                        <p class="text-xs text-zinc-500">Best month</p>
                        <p class="text-2xl font-semibold tabular-nums text-emerald-400">
                            @FormatMoney(best.Net, signed: true)
                        </p>
                        <p class="text-xs text-zinc-500 mt-1">@MonthLabel(best.Year, best.Month)</p>
                    </div>
                }
                @if (_retrospective.WorstMonth is { } worst)
                {
                    <div>
                        <p class="text-xs text-zinc-500">Worst month</p>
                        <p class="text-2xl font-semibold tabular-nums text-rose-400">
                            @FormatMoney(worst.Net, signed: true)
                        </p>
                        <p class="text-xs text-zinc-500 mt-1">@MonthLabel(worst.Year, worst.Month)</p>
                    </div>
                }
            </div>
        </section>
    }

    <section class="border border-zinc-800 rounded p-4 sm:p-5 mb-6">
        <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
            <h2 class="text-sm uppercase tracking-wide text-zinc-400">Running balance</h2>
            <p class="text-xs text-zinc-500">Cumulative net · solid is history, area continues into 6-month forecast</p>
        </div>
        <CumulativeBalanceChart @key="@($"b-{_filterKey}")" Data="_balance" />
    </section>

    @if (_yearlyByStream.Count > 0)
    {
        <section class="border border-zinc-800 rounded p-4 sm:p-5 mb-6">
            <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
                <h2 class="text-sm uppercase tracking-wide text-zinc-400">Yearly trend</h2>
                <p class="text-xs text-zinc-500">Stacked by stream · income above zero, outcome below</p>
            </div>
            <YearlyStreamBars @key="@($"y-{_filterKey}")" Data="_yearlyByStream" />
        </section>
    }

    @if (_historyByStream.Count > 0)
    {
        <section class="border border-zinc-800 rounded p-4 sm:p-5 mb-6">
            <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
                <h2 class="text-sm uppercase tracking-wide text-zinc-400">Monthly contribution — last 12 months</h2>
                <p class="text-xs text-zinc-500">Stacked by stream · income above zero, outcome below</p>
            </div>
            <MonthlyStreamBars @key="@($"m-{_filterKey}")" Data="_historyByStream" />
        </section>
    }

    <section class="border border-zinc-800 rounded overflow-hidden">
        <div class="px-4 sm:px-5 py-3 border-b border-zinc-800">
            <h2 class="text-sm uppercase tracking-wide text-zinc-400">Streams</h2>
        </div>

        <div class="hidden md:block">
            <table class="w-full text-sm">
                <thead class="bg-zinc-900/50 text-zinc-500 text-xs uppercase tracking-wide">
                    <tr>
                        <th class="text-left px-4 py-2 font-medium">Stream</th>
                        <th class="text-right px-4 py-2 font-medium">Expected</th>
                        <th class="text-right px-4 py-2 font-medium">Last month</th>
                        <th class="text-right px-4 py-2 font-medium">Avg</th>
                        <th class="text-left px-4 py-2 font-medium w-32">Trend</th>
                        <th class="text-left px-4 py-2 font-medium w-32">Sparkline</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    @foreach (var t in _trends)
                    {
                        <tr class="hover:bg-zinc-900/40">
                            <td class="px-4 py-2">
                                <a href="streams/@t.Id" class="text-zinc-100 hover:text-white font-medium">@t.Name</a>
                                <div class="text-xs text-zinc-500">@t.Direction · @t.Category</div>
                            </td>
                            <td class="px-4 py-2 text-right text-zinc-300 tabular-nums">@(t.ExpectedAmount is null ? "—" : FormatMoney(t.ExpectedAmount.Value))</td>
                            <td class="px-4 py-2 text-right tabular-nums">
                                @if (t.LastMonthAmount is { } lm && (lm > 0 || (lm != 0 && t.Direction == Direction.Performance)))
                                {
                                    <span class="@(t.Direction == Direction.Income ? "text-emerald-400" : "text-rose-400")">@FormatMoney(lm, signed: t.Direction == Direction.Performance)</span>
                                }
                                else
                                {
                                    <span class="text-zinc-600">—</span>
                                }
                            </td>
                            <td class="px-4 py-2 text-right tabular-nums">
                                @if (t.RecentAverage is { } avg && (avg > 0 || (avg != 0 && t.Direction == Direction.Performance)))
                                {
                                    <span class="text-zinc-300">@FormatMoney(avg, signed: t.Direction == Direction.Performance)</span>
                                }
                                else
                                {
                                    <span class="text-zinc-600">—</span>
                                }
                            </td>
                            <td class="px-4 py-2">
                                <TrendBadge Label="@t.TrendLabel" Slope="@t.Slope" />
                                @if (!string.IsNullOrEmpty(t.TrendDetail))
                                {
                                    <div class="text-xs text-zinc-500 mt-0.5">@t.TrendDetail</div>
                                }
                            </td>
                            <td class="px-4 py-2">
                                <div class="h-6 w-28">
                                    <Sparkline Data="t.Sparkline"
                                               StrokeColor="@(t.Direction == Direction.Income ? "#10b981" : "#f43f5e")" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <ul class="md:hidden divide-y divide-zinc-800">
            @foreach (var t in _trends)
            {
                <li>
                    <a href="streams/@t.Id" class="block px-4 py-3 hover:bg-zinc-900/50">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <div class="min-w-0">
                                <p class="text-zinc-100 font-medium truncate">@t.Name</p>
                                <p class="text-xs text-zinc-500">@t.Direction · @t.Category</p>
                            </div>
                            <TrendBadge Label="@t.TrendLabel" Slope="@t.Slope" />
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <div class="text-xs space-y-0.5 min-w-0">
                                <div class="flex gap-2">
                                    <span class="text-zinc-500">Expected:</span>
                                    <span class="text-zinc-300 tabular-nums">@(t.ExpectedAmount is null ? "—" : FormatMoney(t.ExpectedAmount.Value))</span>
                                </div>
                                <div class="flex gap-2">
                                    <span class="text-zinc-500">Last month:</span>
                                    @if (t.LastMonthAmount is { } lm && (lm > 0 || (lm != 0 && t.Direction == Direction.Performance)))
                                    {
                                        <span class="@(t.Direction == Direction.Income ? "text-emerald-400" : "text-rose-400") tabular-nums">@FormatMoney(lm, signed: t.Direction == Direction.Performance)</span>
                                    }
                                    else
                                    {
                                        <span class="text-zinc-600">—</span>
                                    }
                                </div>
                                <div class="flex gap-2">
                                    <span class="text-zinc-500">Avg:</span>
                                    @if (t.RecentAverage is { } avg && (avg > 0 || (avg != 0 && t.Direction == Direction.Performance)))
                                    {
                                        <span class="text-zinc-300 tabular-nums">@FormatMoney(avg, signed: t.Direction == Direction.Performance)</span>
                                    }
                                    else
                                    {
                                        <span class="text-zinc-600">—</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(t.TrendDetail))
                                {
                                    <p class="text-zinc-500">@t.TrendDetail</p>
                                }
                            </div>
                            <div class="h-7 w-24 shrink-0">
                                <Sparkline Data="t.Sparkline"
                                           StrokeColor="@(t.Direction == Direction.Income ? "#10b981" : "#f43f5e")" />
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    </section>
    }
}

@code {
    private bool _loading = true;
    private bool _hasData;
    private int _activeTab = 0;
    private MonthSummaryView? _summary;
    private ProjectionView? _projection;
    private RetrospectiveView? _retrospective;
    private IReadOnlyList<MonthlyAggregateView> _history = [];
    private IReadOnlyList<StreamTrendView> _trends = [];
    private IReadOnlyList<CumulativeBalancePointView> _balance = [];
    private IReadOnlyList<YearlyAggregateView> _yearly = [];
    private IReadOnlyList<StreamSummaryView> _allStreams = [];
    private IReadOnlyList<MonthlyStreamPointView> _historyByStream = [];
    private IReadOnlyList<YearlyStreamPointView> _yearlyByStream = [];
    private IReadOnlyCollection<Guid>? _filter;
    private string _filterKey = "init";

    protected override async Task OnInitializedAsync()
    {
        var existing = await Query.ListOperationsAsync(includeTerminal: false, CancellationToken.None);
        _hasData = existing.Count > 0;
        if (_hasData)
        {
            _allStreams = await Analytics.GetStreamSummariesAsync(CancellationToken.None);
            await LoadAnalyticsAsync();
        }
        _loading = false;
    }

    private async Task LoadAnalyticsAsync()
    {
        _summary = await Analytics.GetCurrentMonthAsync(CancellationToken.None, _filter);
        _history = await Analytics.GetMonthlyHistoryAsync(12, CancellationToken.None, _filter);
        _trends = await Analytics.GetStreamTrendsAsync(12, CancellationToken.None, _filter);
        _projection = await Analytics.GetProjectionAsync(CancellationToken.None, _filter);
        _retrospective = await Analytics.GetRetrospectiveAsync(CancellationToken.None, _filter);
        _balance = await Analytics.GetCumulativeBalanceAsync(6, CancellationToken.None, _filter);
        _yearly = await Analytics.GetYearlyHistoryAsync(CancellationToken.None, _filter);
        _historyByStream = await Analytics.GetMonthlyHistoryByStreamAsync(12, CancellationToken.None, _filter);
        _yearlyByStream = await Analytics.GetYearlyHistoryByStreamAsync(CancellationToken.None, _filter);
    }

    private async Task OnFilterChangedAsync(IReadOnlyCollection<Guid> selection)
    {
        _filter = selection;
        await LoadAnalyticsAsync();
        _filterKey = $"{selection.Count}-{string.Join(",", selection.OrderBy(g => g))}";
    }

    private string TabClass(int idx) =>
        _activeTab == idx
            ? "px-4 py-2 text-sm font-medium text-zinc-100 border-b-2 border-zinc-100 -mb-px"
            : "px-4 py-2 text-sm text-zinc-400 hover:text-zinc-200 border-b-2 border-transparent -mb-px";

    private static string MonthLabel(int year, int month) =>
        $"{System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(month)} {year}";

    private static string FormatMoney(decimal v, bool signed = false)
    {
        var s = Math.Abs(v).ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
        if (!signed) return $"${s}";
        if (v > 0) return $"+${s}";
        if (v < 0) return $"−${s}";
        return $"${s}";
    }

    private static string NetColor(decimal n) => n switch
    {
        > 0 => "text-emerald-400",
        < 0 => "text-rose-400",
        _ => "text-zinc-200",
    };

    private static string DeltaColor(decimal d) => d switch
    {
        > 0 => "text-emerald-400",
        < 0 => "text-rose-400",
        _ => "text-zinc-400",
    };

    private static string DeltaArrow(decimal d) => d switch
    {
        > 0 => "↑",
        < 0 => "↓",
        _ => "·",
    };
}
