@page "/"
@rendermode InteractiveServer
@inject StreamQueryService Query

<PageTitle>Observa</PageTitle>

<header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
    <p class="text-sm text-zinc-500">Snapshot of your active streams.</p>
</header>

@if (_rows is null)
{
    <p class="text-zinc-500 text-sm">Loading…</p>
}
else if (_rows.Count == 0)
{
    <div class="border border-dashed border-zinc-700 rounded p-8 text-center">
        <p class="text-zinc-400 mb-3">No streams yet.</p>
        <a href="streams/new" class="inline-block px-4 py-2 bg-zinc-100 text-zinc-900 rounded text-sm font-medium hover:bg-white">
            Register your first stream
        </a>
    </div>
}
else
{
    <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="border border-zinc-800 rounded p-4">
            <p class="text-xs text-zinc-500 uppercase tracking-wide">Active streams</p>
            <p class="text-2xl font-semibold mt-1 tabular-nums">@_rows.Count(r => r.Status == StreamStatus.Active)</p>
        </div>
        <div class="border border-zinc-800 rounded p-4">
            <p class="text-xs text-zinc-500 uppercase tracking-wide">Income streams</p>
            <p class="text-2xl font-semibold mt-1 tabular-nums text-emerald-400">
                @_rows.Count(r => r.Direction == Direction.Income)
            </p>
        </div>
        <div class="border border-zinc-800 rounded p-4">
            <p class="text-xs text-zinc-500 uppercase tracking-wide">Outcome streams</p>
            <p class="text-2xl font-semibold mt-1 tabular-nums text-rose-400">
                @_rows.Count(r => r.Direction == Direction.Outcome)
            </p>
        </div>
    </div>

    <p class="text-sm">
        <a href="streams" class="text-zinc-300 hover:text-white underline underline-offset-4">View all streams →</a>
    </p>
}

@code {
    private IReadOnlyList<StreamOperationsView>? _rows;

    protected override async Task OnInitializedAsync()
    {
        _rows = await Query.ListOperationsAsync(includeTerminal: false, CancellationToken.None);
    }
}
