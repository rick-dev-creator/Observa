@page "/"
@rendermode InteractiveServer
@using Observa.Features.Streams.Enums
@using Observa.Features.Streams.Services.Views
@using Observa.Features.Streams.Grains
@inject StreamAnalyticsService Analytics
@inject StreamQueryService Query
@inject IGrainFactory Grains

<PageTitle>Observa</PageTitle>

@if (_loading)
{
    <p class="text-zinc-500 text-sm">Loading…</p>
}
else if (!_hasData)
{
    <div class="border border-dashed border-zinc-700 rounded p-8 sm:p-12 text-center">
        <h1 class="text-2xl font-semibold mb-2">Welcome to Observa</h1>
        <p class="text-zinc-400 mb-6">No streams yet. Register your first income or outcome stream to start.</p>
        <a href="streams" class="inline-block px-4 py-2 bg-zinc-100 text-zinc-900 rounded text-sm font-medium hover:bg-white">
            Register a stream
        </a>
    </div>
}
else
{
    <div class="flex gap-1 mb-6 border-b border-zinc-800" role="tablist">
        <button type="button" role="tab" class="@TabClass(0)" @onclick="@(() => _activeTab = 0)">Overview</button>
        <button type="button" role="tab" class="@TabClass(1)" @onclick="@(() => _activeTab = 1)">What if…</button>
        <button type="button" role="tab" class="@TabClass(2)" @onclick="@(() => _activeTab = 2)">Assets</button>
    </div>

    @if (_activeTab == 1)
    {
        <WhatIfTab Trends="_trends" />
    }
    else if (_activeTab == 2)
    {
        <AssetHoldingsTab Holdings="_holdings" />
    }
    else
    {
        <div class="mb-4">
            <StreamFilter Streams="_allStreams" SelectionChanged="OnFilterChangedAsync" />
        </div>

        <!-- HERO -->
        <section class="border border-zinc-800 rounded-xl p-6 mb-4 flex flex-wrap items-center justify-between gap-6">
            <div>
                <p class="text-xs uppercase tracking-wide text-zinc-500 font-semibold">Patrimonio neto · hoy</p>
                <div class="text-4xl sm:text-5xl font-semibold tabular-nums mt-1 @NetColor(NetWorth)">@FormatMoney(NetWorth)</div>
                <div class="flex gap-5 text-sm mt-2">
                    <span><span class="@DeltaColor(MonthNet) tabular-nums">@FormatMoney(MonthNet, signed: true)</span> <span class="text-zinc-500">este mes</span></span>
                    <span><span class="@DeltaColor(Ytd) tabular-nums">@FormatMoney(Ytd, signed: true)</span> <span class="text-zinc-500">este año</span></span>
                </div>
            </div>
            <div class="flex gap-7 text-right">
                <div>
                    <div class="text-2xl font-semibold tabular-nums text-zinc-100">@FormatMoney(Cash)</div>
                    <div class="text-xs text-zinc-500 mt-1"><span class="text-sky-400">●</span> Caja · estable</div>
                </div>
                <div>
                    <div class="text-2xl font-semibold tabular-nums text-zinc-100">@FormatMoney(Invested)</div>
                    <div class="text-xs text-zinc-500 mt-1"><span class="text-amber-400">●</span> Invertido · volátil</div>
                </div>
            </div>
        </section>

        <!-- KPI STRIP -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
            <div class="border border-zinc-800 rounded-lg p-4">
                <div class="text-xs text-zinc-500">Ingreso · este mes</div>
                <div class="text-2xl font-semibold tabular-nums text-emerald-400 mt-1">@FormatMoney(_summary?.IncomeMTD ?? 0m)</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-4">
                <div class="text-xs text-zinc-500">Gasto · este mes</div>
                <div class="text-2xl font-semibold tabular-nums text-zinc-100 mt-1">@FormatMoney(_summary?.OutcomeMTD ?? 0m)</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-4">
                <div class="text-xs text-zinc-500">Flujo neto · este mes</div>
                <div class="text-2xl font-semibold tabular-nums @DeltaColor(MonthNet) mt-1">@FormatMoney(MonthNet, signed: true)</div>
            </div>
            <div class="border border-zinc-800 rounded-lg p-4">
                <div class="text-xs text-zinc-500">Invertido</div>
                <div class="text-2xl font-semibold tabular-nums text-zinc-100 mt-1">@FormatMoney(HoldingsValue)</div>
                <div class="text-xs mt-0.5 tabular-nums @DeltaColor(HoldingsReturn)">@FormatMoney(HoldingsReturn, signed: true) no realizado</div>
            </div>
        </section>

        <!-- PROJECTION CONE -->
        <section class="border border-zinc-800 rounded-xl p-5 mb-4">
            <div class="mb-1">
                <h2 class="text-sm font-semibold text-zinc-200">Proyección de patrimonio</h2>
                <p class="text-xs text-zinc-500">Historia real (línea), proyección esperada (punteada) y el rango por volatilidad del portafolio (banda).</p>
            </div>
            @if (_trajectory.Count >= 2)
            {
                <NetWorthConeChart Data="_trajectory" />
                <div class="flex flex-wrap gap-x-5 gap-y-1 text-[11px] text-zinc-500 mt-3">
                    <span><span class="text-sky-400">━</span> Historia real</span>
                    <span><span class="text-zinc-300">┈</span> Proyección esperada</span>
                    <span><span class="text-amber-400">▨</span> Rango por volatilidad</span>
                </div>
            }
            else
            {
                <div class="border border-dashed border-zinc-700 rounded p-6 text-center text-zinc-500 text-sm">
                    Aún no hay suficiente historia para proyectar.
                </div>
            }
            <details class="mt-3 border-t border-zinc-800 pt-3">
                <summary class="text-xs text-zinc-500 cursor-pointer select-none">Ajustes de saldo inicial</summary>
                <div class="mt-3 flex flex-wrap gap-x-8 gap-y-3">
                    <label class="flex flex-col gap-1 text-xs">
                        <span class="text-zinc-500">Opening balance</span>
                        <input type="number" step="100" value="@_openingBalance" @onchange="OnOpeningBalanceChangedAsync"
                               class="w-36 bg-zinc-900 border border-zinc-700 rounded px-2 py-1 text-sm text-zinc-100 tabular-nums" />
                    </label>
                    <label class="flex flex-col gap-1 text-xs">
                        <span class="text-zinc-500">Expenses tracked from</span>
                        <input type="date" value="@(_expenseTrackingStart?.ToString("yyyy-MM-dd"))" @onchange="OnExpenseTrackingStartChangedAsync"
                               class="w-40 bg-zinc-900 border border-zinc-700 rounded px-2 py-1 text-sm text-zinc-100 tabular-nums" />
                    </label>
                </div>
            </details>
        </section>

        <!-- FLOW (full width) -->
        <section class="border border-zinc-800 rounded-xl p-5 mb-4">
            <h2 class="text-sm font-semibold text-zinc-200">Flujo @(_flowMonthLabel is null ? "del mes" : $"· {_flowMonthLabel}")</h2>
            <p class="text-xs text-zinc-500 mb-2">Dónde entra y a dónde sale tu dinero.</p>
            @if (_flowSources.Count > 0)
            {
                <FlowSankey Sources="_flowSources" Uses="_flowUses" />
            }
            else
            {
                <div class="border border-dashed border-zinc-700 rounded p-6 text-center text-zinc-500 text-sm">Sin movimientos en el periodo.</div>
            }
        </section>

        <!-- PORTFOLIO -->
        <section class="border border-zinc-800 rounded-xl p-5 mb-4">
            <h2 class="text-sm font-semibold text-zinc-200">Portafolio <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-400 align-middle">volátil</span></h2>
            <p class="text-xs text-zinc-500 mb-2">Composición · marcado a precio en vivo.</p>
            @if (_holdings.Any(h => !h.IsClosed && h.ValueUsd > 0))
            {
                <div class="max-w-2xl"><AllocationDonut Holdings="_holdings" /></div>
            }
            else
            {
                <div class="border border-dashed border-zinc-700 rounded p-6 text-center text-zinc-500 text-sm">Sin holdings registrados.</div>
            }
        </section>

        <!-- STREAMS DETAIL (demoted) -->
        <details class="border border-zinc-800 rounded-xl overflow-hidden">
            <summary class="px-5 py-3 text-sm uppercase tracking-wide text-zinc-400 cursor-pointer select-none">Streams · detalle</summary>
            <table class="w-full text-sm border-t border-zinc-800">
                <thead class="bg-zinc-900/50 text-zinc-500 text-xs uppercase tracking-wide">
                    <tr>
                        <th class="text-left px-4 py-2 font-medium">Stream</th>
                        <th class="text-right px-4 py-2 font-medium">Expected</th>
                        <th class="text-right px-4 py-2 font-medium">Last month</th>
                        <th class="text-right px-4 py-2 font-medium">Avg</th>
                        <th class="text-left px-4 py-2 font-medium w-32">Trend</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    @foreach (var t in _trends)
                    {
                        <tr class="hover:bg-zinc-900/40">
                            <td class="px-4 py-2">
                                <a href="streams/@t.Id" class="text-zinc-100 hover:text-white font-medium">@t.Name</a>
                                <div class="text-xs text-zinc-500">@t.Direction · @t.Category</div>
                            </td>
                            <td class="px-4 py-2 text-right text-zinc-300 tabular-nums">@(t.ExpectedAmount is null ? "—" : FormatMoney(t.ExpectedAmount.Value))</td>
                            <td class="px-4 py-2 text-right tabular-nums">
                                @if (t.LastMonthAmount is { } lm && (lm > 0 || (lm != 0 && t.Direction == Direction.Performance)))
                                {
                                    <span class="@ValueColor(t.Direction, lm)">@FormatMoney(lm, signed: t.Direction == Direction.Performance)</span>
                                }
                                else { <span class="text-zinc-600">—</span> }
                            </td>
                            <td class="px-4 py-2 text-right tabular-nums">
                                @if (t.RecentAverage is { } avg && (avg > 0 || (avg != 0 && t.Direction == Direction.Performance)))
                                {
                                    <span class="text-zinc-300">@FormatMoney(avg, signed: t.Direction == Direction.Performance)</span>
                                }
                                else { <span class="text-zinc-600">—</span> }
                            </td>
                            <td class="px-4 py-2"><TrendBadge Label="@t.TrendLabel" Slope="@t.Slope" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </details>
    }
}

@code {
    private bool _loading = true;
    private bool _hasData;
    private int _activeTab = 0;

    private MonthSummaryView? _summary;
    private RetrospectiveView? _retrospective;
    private IReadOnlyList<StreamTrendView> _trends = [];
    private IReadOnlyList<StreamSummaryView> _allStreams = [];
    private IReadOnlyList<AssetHoldingView> _holdings = [];
    private IReadOnlyList<CumulativeBalancePointView> _trajectory = [];
    private IReadOnlyList<MonthlyStreamPointView> _monthByStream = [];

    private List<FlowSankey.FlowNode> _flowSources = [];
    private List<FlowSankey.FlowNode> _flowUses = [];
    private string? _flowMonthLabel;

    private IReadOnlyCollection<Guid>? _filter;
    private decimal _openingBalance;
    private DateTimeOffset? _expenseTrackingStart;

    private CumulativeBalancePointView? Hero => _trajectory.LastOrDefault(p => !p.IsProjected);
    private decimal NetWorth => Hero?.Balance ?? 0m;
    private decimal Cash => Hero?.StableBalance ?? 0m;
    private decimal Invested => Hero?.VolatileBalance ?? 0m;
    private decimal Ytd => _retrospective?.YearToDateNet ?? 0m;
    private decimal MonthNet => _summary?.NetMTD ?? 0m;
    private decimal HoldingsValue => _holdings.Where(h => !h.IsClosed).Sum(h => h.ValueUsd);
    private decimal HoldingsReturn => _holdings.Where(h => !h.IsClosed).Sum(h => h.ReturnUsd);

    protected override async Task OnInitializedAsync()
    {
        var existing = await Query.ListOperationsAsync(includeTerminal: false, CancellationToken.None);
        _hasData = existing.Count > 0;
        if (_hasData)
        {
            _allStreams = await Analytics.GetStreamSummariesAsync(CancellationToken.None);
            await LoadAnalyticsAsync();
        }
        _loading = false;
    }

    private async Task LoadAnalyticsAsync()
    {
        _summary = await Analytics.GetCurrentMonthAsync(CancellationToken.None, _filter);
        _retrospective = await Analytics.GetRetrospectiveAsync(CancellationToken.None, _filter);
        _trends = await Analytics.GetStreamTrendsAsync(12, CancellationToken.None, _filter);
        _holdings = await Analytics.GetAssetHoldingsAsync(CancellationToken.None);
        _trajectory = await Analytics.GetNetWorthTrajectoryAsync(12, CancellationToken.None, _filter);
        _monthByStream = await Analytics.GetMonthlyHistoryByStreamAsync(3, CancellationToken.None, _filter);

        var settings = Grains.GetGrain<IOverviewSettingsGrain>(OverviewSettingsGrain.Key);
        _openingBalance = await settings.GetOpeningBalanceAsync();
        _expenseTrackingStart = await settings.GetExpenseTrackingStartAsync();

        BuildFlow();
    }

    // Picks the most recent month that has movement (preferring a complete month over the partial current one)
    // and splits it into income sources, expense uses, and a "savings → invest" node.
    private void BuildFlow()
    {
        var now = DateTimeOffset.UtcNow;
        var months = _monthByStream.Select(r => (r.Year, r.Month)).Distinct()
            .OrderByDescending(m => m.Year).ThenByDescending(m => m.Month).ToList();

        (int Y, int M)? pick = null, fallback = null;
        foreach (var (y, mo) in months)
        {
            var rows = _monthByStream.Where(r => r.Year == y && r.Month == mo).ToList();
            var inc = rows.Where(r => r.Direction == Direction.Income).Sum(r => r.Amount);
            var outc = rows.Where(r => r.Direction == Direction.Outcome).Sum(r => r.Amount);
            if (inc <= 0 && outc <= 0) continue;
            var isCurrent = y == now.Year && mo == now.Month;
            if (!isCurrent) { pick = (y, mo); break; }
            fallback ??= (y, mo);
        }
        pick ??= fallback;

        _flowSources = [];
        _flowUses = [];
        _flowMonthLabel = null;
        if (pick is not { } chosen) return;

        var picked = _monthByStream.Where(r => r.Year == chosen.Y && r.Month == chosen.M).ToList();
        _flowMonthLabel = new DateTimeOffset(chosen.Y, chosen.M, 1, 0, 0, 0, TimeSpan.Zero).ToString("MMM yyyy");

        var incomeRows = picked.Where(r => r.Direction == Direction.Income && r.Amount > 0)
            .OrderByDescending(r => r.Amount).Select(r => (r.StreamName, r.Amount)).ToList();
        var expenseRows = picked.Where(r => r.Direction == Direction.Outcome && r.Amount > 0)
            .OrderByDescending(r => r.Amount).Select(r => (r.StreamName, r.Amount)).ToList();

        _flowSources = FoldTop(incomeRows, 6).Select(x => new FlowSankey.FlowNode(x.Name, x.Amount)).ToList();

        var savings = incomeRows.Sum(r => r.Amount) - expenseRows.Sum(r => r.Amount);
        if (savings > 0)
            _flowUses.Add(new FlowSankey.FlowNode("Ahorro / Inversión", savings, Keep: true));
        _flowUses.AddRange(FoldTop(expenseRows, 6).Select(x => new FlowSankey.FlowNode(x.Name, x.Amount)));
    }

    // Keeps a flow chart legible: the top (n-1) items, with the remainder folded into "Otros".
    private static List<(string Name, decimal Amount)> FoldTop(List<(string Name, decimal Amount)> items, int n)
    {
        if (items.Count <= n) return items;
        var top = items.Take(n - 1).ToList();
        top.Add(("Otros", items.Skip(n - 1).Sum(x => x.Amount)));
        return top;
    }

    private async Task OnFilterChangedAsync(IReadOnlyCollection<Guid> selection)
    {
        _filter = selection;
        await LoadAnalyticsAsync();
    }

    private async Task OnOpeningBalanceChangedAsync(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v))
        {
            await Grains.GetGrain<IOverviewSettingsGrain>(OverviewSettingsGrain.Key).SetOpeningBalanceAsync(v);
            _openingBalance = v;
            _trajectory = await Analytics.GetNetWorthTrajectoryAsync(12, CancellationToken.None, _filter);
        }
    }

    private async Task OnExpenseTrackingStartChangedAsync(ChangeEventArgs e)
    {
        DateTimeOffset? start = DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d)
            ? new DateTimeOffset(d.Year, d.Month, d.Day, 0, 0, 0, TimeSpan.Zero)
            : null;
        await Grains.GetGrain<IOverviewSettingsGrain>(OverviewSettingsGrain.Key).SetExpenseTrackingStartAsync(start);
        _expenseTrackingStart = start;
        _trajectory = await Analytics.GetNetWorthTrajectoryAsync(12, CancellationToken.None, _filter);
    }

    private string TabClass(int idx) =>
        _activeTab == idx
            ? "px-4 py-2 text-sm font-medium text-zinc-100 border-b-2 border-zinc-100 -mb-px"
            : "px-4 py-2 text-sm text-zinc-400 hover:text-zinc-200 border-b-2 border-transparent -mb-px";

    private static string FormatMoney(decimal v, bool signed = false)
    {
        var s = Math.Abs(v).ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
        if (!signed) return $"${s}";
        if (v > 0) return $"+${s}";
        if (v < 0) return $"−${s}";
        return $"${s}";
    }

    private static string NetColor(decimal n) => n switch
    {
        > 0 => "text-emerald-400",
        < 0 => "text-rose-400",
        _ => "text-zinc-100",
    };

    private static string ValueColor(Direction d, decimal v) => d switch
    {
        Direction.Income => "text-emerald-400",
        Direction.Outcome => "text-rose-400",
        Direction.Performance => v < 0 ? "text-rose-400" : "text-emerald-400",
        _ => "text-zinc-300",
    };

    private static string DeltaColor(decimal d) => d switch
    {
        > 0 => "text-emerald-400",
        < 0 => "text-rose-400",
        _ => "text-zinc-400",
    };
}
