@using System.Text
@using System.Globalization

@* Money flow for a month: green = income in, sky = what you keep (savings/invest), amber = spend.
   Filled ribbons, semantic colour — reads without a legend. *@
<svg viewBox="0 0 900 330" class="w-full h-auto" style="overflow:visible" role="img" aria-label="Monthly money flow">
    @((MarkupString)_svg)
</svg>

@code {
    public sealed record FlowNode(string Name, decimal Amount, bool Keep = false);

    [Parameter, EditorRequired] public IReadOnlyList<FlowNode> Sources { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<FlowNode> Uses { get; set; } = [];

    private string _svg = "";

    private const string Ink = "#e4e4e7", Muted = "#71717a", Green = "#34d399", Sky = "#38bdf8", Amber = "#fbbf24";
    private static readonly CultureInfo Ci = CultureInfo.InvariantCulture;
    private static string F(double x) => x.ToString("0.#", Ci);
    private static string Fmt(decimal v) => "$" + Math.Round(v).ToString("N0", Ci);

    protected override void OnParametersSet() => _svg = Build();

    private static string Ribbon(double x1, double t1, double b1, double x2, double t2, double b2, string fill, double op)
    {
        var cx = (x1 + x2) / 2;
        return $"<path d='M {F(x1)} {F(t1)} C {F(cx)} {F(t1)} {F(cx)} {F(t2)} {F(x2)} {F(t2)} "
             + $"L {F(x2)} {F(b2)} C {F(cx)} {F(b2)} {F(cx)} {F(b1)} {F(x1)} {F(b1)} Z' "
             + $"fill='{fill}' fill-opacity='{F(op)}' stroke='{fill}' stroke-opacity='0.4' stroke-width='0.6'/>";
    }

    private string Build()
    {
        if (Sources.Count == 0 || Uses.Count == 0) return "";
        var total = (double)Sources.Sum(s => s.Amount);
        var uTotal = (double)Uses.Sum(u => u.Amount);
        if (total <= 0 || uTotal <= 0) return "";

        const double W = 900, H = 330, top = 46, botPad = 22;
        const double plotH = H - top - botPad;
        const double Lx = 212, Rx = W - 212, Hw = 18;
        const double Hx = (Lx + Rx) / 2 - Hw / 2;
        const double gapS = 14, gapU = 16;

        var sScale = (plotH - (Sources.Count - 1) * gapS) / total;
        var sT = new double[Sources.Count];
        var sB = new double[Sources.Count];
        var y = top;
        for (var i = 0; i < Sources.Count; i++)
        {
            var h = (double)Sources[i].Amount * sScale;
            sT[i] = y; sB[i] = y + h; y += h + gapS;
        }

        var uScale = (plotH - (Uses.Count - 1) * gapU) / uTotal;
        var uT = new double[Uses.Count];
        var uB = new double[Uses.Count];
        y = top;
        for (var i = 0; i < Uses.Count; i++)
        {
            var h = (double)Uses[i].Amount * uScale;
            uT[i] = y; uB[i] = y + h; y += h + gapU;
        }

        var sb = new StringBuilder();

        // direction headers
        sb.Append($"<text x='{F(Lx - 16)}' y='{F(top - 20)}' text-anchor='end' font-size='12' letter-spacing='1.5' fill='{Green}' font-weight='700'>ENTRA ▸</text>");
        sb.Append($"<text x='{F(Rx + 16)}' y='{F(top - 20)}' text-anchor='start' font-size='12' letter-spacing='1.5' fill='{Amber}' font-weight='700'>▸ SALE</text>");

        // income ribbons + nodes (single-line label: name + amount)
        for (var i = 0; i < Sources.Count; i++)
        {
            sb.Append(Ribbon(Lx, sT[i], sB[i], Hx, sT[i], sB[i], Green, 0.42));
            sb.Append($"<rect x='{F(Lx - 5)}' y='{F(sT[i])}' width='5' height='{F(sB[i] - sT[i])}' rx='2' fill='{Green}'/>");
            var my = (sT[i] + sB[i]) / 2;
            sb.Append($"<text x='{F(Lx - 14)}' y='{F(my + 4)}' text-anchor='end' font-size='13' fill='{Ink}'>{Esc(Sources[i].Name)} <tspan fill='{Muted}' font-size='11'>{Fmt(Sources[i].Amount)}</tspan></text>");
        }

        // hub
        sb.Append($"<rect x='{F(Hx)}' y='{F(top)}' width='{F(Hw)}' height='{F(plotH)}' rx='4' fill='{Ink}' opacity='0.85'/>");
        sb.Append($"<text x='{F(Hx + Hw / 2)}' y='{F(top - 8)}' text-anchor='middle' font-size='12' fill='{Ink}' font-weight='700'>{Fmt(Sources.Sum(s => s.Amount))}</text>");

        // outflow ribbons + nodes
        var expIdx = 0;
        for (var i = 0; i < Uses.Count; i++)
        {
            var keep = Uses[i].Keep;
            var fill = keep ? Sky : Amber;
            var op = keep ? 0.62 : Math.Max(0.6 - expIdx * 0.07, 0.3);
            if (!keep) expIdx++;
            sb.Append(Ribbon(Hx + Hw, uT[i], uB[i], Rx, uT[i], uB[i], fill, op));
            sb.Append($"<rect x='{F(Rx)}' y='{F(uT[i])}' width='5' height='{F(uB[i] - uT[i])}' rx='2' fill='{fill}'/>");
            var my = (uT[i] + uB[i]) / 2;
            sb.Append($"<text x='{F(Rx + 14)}' y='{F(my + 4)}' font-size='13' fill='{(keep ? Sky : Ink)}' font-weight='{(keep ? 660 : 400)}'>{Esc(Uses[i].Name)} <tspan fill='{Muted}' font-size='11' font-weight='400'>{Fmt(Uses[i].Amount)}</tspan></text>");
        }

        return sb.ToString();
    }

    private static string Esc(string s) =>
        s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");
}
