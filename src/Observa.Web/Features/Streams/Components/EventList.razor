@if (Events.Count == 0)
{
    <p class="text-zinc-500 text-sm">No events recorded.</p>
}
else
{
    <div class="border border-zinc-800 rounded overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-zinc-900 text-zinc-400 uppercase text-xs tracking-wide">
                <tr>
                    <th class="text-left px-3 py-2 font-medium w-44">Occurred at (UTC)</th>
                    <th class="text-right px-3 py-2 font-medium w-32">Amount</th>
                    <th class="text-left px-3 py-2 font-medium w-32">Source</th>
                    <th class="text-left px-3 py-2 font-medium">External ref</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800">
                @foreach (var e in Events)
                {
                    <tr class="hover:bg-zinc-900/50">
                        <td class="px-3 py-1.5 text-zinc-300 tabular-nums whitespace-nowrap">@e.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="px-3 py-1.5 text-right tabular-nums">
                            <MoneyDisplay Amount="e.Amount" Direction="Direction" />
                        </td>
                        <td class="px-3 py-1.5 text-zinc-400">@e.Source</td>
                        <td class="px-3 py-1.5 text-zinc-500 font-mono text-xs">@(e.ExternalRef ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FlowEventView> Events { get; set; } = [];
    [Parameter] public Direction Direction { get; set; }
}
