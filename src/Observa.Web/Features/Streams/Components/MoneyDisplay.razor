<span class="@ColorClass tabular-nums">@Formatted</span>

@code {
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public Direction? Direction { get; set; }

    private string ColorClass => Direction switch
    {
        Enums.Direction.Income => "text-emerald-400",
        Enums.Direction.Outcome => "text-rose-400",
        _ => "text-zinc-200",
    };

    private string Formatted
    {
        get
        {
            var sign = Direction == Enums.Direction.Outcome ? "−" : "";
            return $"{sign}${Amount:N2}";
        }
    }
}
