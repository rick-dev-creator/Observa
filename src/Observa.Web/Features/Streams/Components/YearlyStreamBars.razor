@using ApexCharts

<div class="w-full">
    <ApexChart TItem="YearlyStreamPointView"
               Options="@_options"
               Height="280"
               Debug="false">

        @foreach (var (streamId, name, direction) in _seriesOrder)
        {
            <ApexPointSeries TItem="YearlyStreamPointView"
                             Items="@_byStream[streamId]"
                             Name="@name"
                             SeriesType="SeriesType.Bar"
                             XValue="@(p => p.Label)"
                             YValue="@(p => direction == Direction.Performance ? p.Amount : (direction == Direction.Income ? p.Amount : -p.Amount))" />
        }

        @if (_netSeries.Count > 0)
        {
            <ApexPointSeries TItem="YearlyStreamPointView"
                             Items="_netSeries"
                             Name="Net"
                             SeriesType="SeriesType.Line"
                             XValue="@(p => p.Label)"
                             YValue="@(p => p.Amount)" />
        }
    </ApexChart>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<YearlyStreamPointView> Data { get; set; } = [];

    private ApexChartOptions<YearlyStreamPointView> _options = null!;
    private Dictionary<Guid, List<YearlyStreamPointView>> _byStream = new();
    private List<(Guid StreamId, string Name, Direction Direction)> _seriesOrder = new();
    private List<YearlyStreamPointView> _netSeries = new();

    protected override void OnParametersSet()
    {
        _byStream = Data
            .GroupBy(p => p.StreamId)
            .ToDictionary(g => g.Key, g => g.OrderBy(p => p.Year).ToList());

        _seriesOrder = Data
            .GroupBy(p => (p.StreamId, p.StreamName, p.Direction))
            .Select(g => (g.Key.StreamId, g.Key.StreamName, g.Key.Direction))
            .OrderByDescending(t => t.Direction == Direction.Income)
            .ThenBy(t => t.StreamName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _netSeries = Data
            .GroupBy(p => p.Year)
            .OrderBy(g => g.Key)
            .Select(g => new YearlyStreamPointView(
                Year: g.Key,
                StreamId: Guid.Empty,
                StreamName: "Net",
                Direction: Direction.Income,
                Amount: Math.Round(g.Sum(p => p.Direction == Direction.Performance ? p.Amount : (p.Direction == Direction.Income ? p.Amount : -p.Amount)), 2)))
            .ToList();

        _options = new ApexChartOptions<YearlyStreamPointView>
        {
            Chart = new Chart
            {
                Background = "transparent",
                ForeColor = "#a1a1aa",
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations { Enabled = true, Speed = 400 },
                Stacked = true,
                FontFamily = "ui-sans-serif, system-ui",
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar { ColumnWidth = "55%", BorderRadius = 2 }
            },
            DataLabels = new DataLabels { Enabled = false },
            Stroke = new Stroke
            {
                Curve = Enumerable.Repeat(Curve.Smooth, _seriesOrder.Count + 1).ToList(),
                Width = Enumerable.Repeat(0d, _seriesOrder.Count).Append(3d).ToList(),
            },
            Markers = new Markers { Size = 4, StrokeWidth = 0 },
            Grid = new Grid { BorderColor = "#27272a", StrokeDashArray = 3 },
            Xaxis = new XAxis
            {
                AxisBorder = new AxisBorder { Color = "#27272a" },
                AxisTicks = new AxisTicks { Color = "#27272a" },
            },
            Yaxis = new List<YAxis>
            {
                new()
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = "function(val) { return '$' + Math.round(Math.abs(val)).toLocaleString('en-US'); }",
                    },
                },
            },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark,
                Shared = true,
                Intersect = false,
                Y = new TooltipY { Formatter = "function(val) { return '$' + Math.round(Math.abs(val)).toLocaleString('en-US'); }" },
            },
            Legend = new Legend { Position = LegendPosition.Top, HorizontalAlign = Align.Right },
        };
    }
}
