# Copy to .env and fill in real values. .env is gitignored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

PATREON_DISPLAY_NAME=Patreon
PATREON_ACCESS_TOKEN=

# BloFin affiliate (rebate / commission tracking) — optional
BLOFIN_DISPLAY_NAME=Affiliate
BLOFIN_API_KEY=
BLOFIN_SECRET_KEY=
BLOFIN_PASSPHRASE=

# Solana wallet (asset value tracking) — optional
SOLANA_DISPLAY_NAME=Wallet
SOLANA_WALLET_ADDRESS=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MIN_VALUE_USD=10
# Poll cadence as [hh]:mm:ss. Crypto is volatile, so the default is hourly.
# WARNING: this is .NET TimeSpan format — "24:00:00" parses as 24 DAYS, not 24 hours.
# For 1 day use "1.00:00:00"; for 1 hour use "01:00:00".
SOLANA_POLL_INTERVAL=01:00:00

WEB_PORT=8080
